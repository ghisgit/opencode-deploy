# --- opencode web server port (host:container) ---
PORT=4096

# --- opencode version to build (latest, or pin like v1.18.14) ---
OPENCODE_VERSION=latest

# --- Optional tools baked into the image at build time ---
# false = do not install, latest = latest release, or pin a version.
# gh keeps the v prefix (v2.97.0); uv strips it (0.12.2 or v0.12.2).
GH_INSTALL_VERSION=false
UV_INSTALL_VERSION=false
# Mirror prefix for the build downloads, e.g. https://ghproxy.com/ (empty = direct GitHub)
INSTALL_GITHUB_MIRROR=

# --- User/Group id mapping (match your host user with `id -u` / `id -g`) ---
PUID=1000
PGID=1000

# --- Host-side data directories (relative to the compose file) ---
# DATA_DIR holds opencode's persisted data (config/share/state/cache subdirs),
# mounted to the container's fixed home directory (/data)
DATA_DIR=./opencode
WORKSPACE=./workspace

# --- OpenCode web server auth ---
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# --- Optional provider API keys (uncomment and fill in as needed) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
